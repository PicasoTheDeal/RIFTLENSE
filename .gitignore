# raw downloads never go to git
data/raw/*
!data/raw/.gitkeep

# big processed rasters, keep small tiles only
*.tif
*.tiff
*.hdf
*.h5
*.nc
*.zip
*.SAFE/

# notebooks checkpoints and python junk
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/

# node & vite
node_modules/
dist/
.vite-temp/

# cloudflare local dev
.wrangler/

# environment variables & system files
.env
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*